+    private void handleMiuiCitKernelTap() {
+        final long now = SystemClock.elapsedRealtime();
+
+        if (miuiCitLastTapElapsedRealtime == 0
+                || now - miuiCitLastTapElapsedRealtime > MIUICIT_MAX_TAP_INTERVAL_MS) {
+            miuiCitTapCount = 0;
+        }
+
+        miuiCitLastTapElapsedRealtime = now;
+        miuiCitTapCount++;
+
+        if (miuiCitTapCount < MIUICIT_REQUIRED_TAPS) {
+            return;
+        }
+
+        miuiCitTapCount = 0;
+        miuiCitLastTapElapsedRealtime = 0L;
+
