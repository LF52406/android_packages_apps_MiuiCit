android_app_import {
    name: "MiuiCit",
    apk: "prebuilt/MiuiCit.apk",
    certificate: "platform",
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "miuicit_mondrian_config",
    src: "config/mondrian/cit_param_config.json",
    filename: "cit_param_config.json",
    device_specific: true,
}

prebuilt_etc {
    name: "miuicit_hardware_init",
    src: "init/init.miuicit.rc",
    filename: "init.miuicit.rc",
    sub_dir: "init",
    vendor: true,
}
